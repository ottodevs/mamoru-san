# Copy to .env (gitignored) and fill in real values. Never commit real keys.

# Intercepta (Web3 Antivirus) API key. Without it, every screen fails closed:
# HOLD, reason "no_api_key". Get one at https://intercepta.io/ethglobal
INTERCEPTA_API_KEY=

# Process-wide request budget. Once exceeded, calls fail closed: HOLD, reason
# "budget_exhausted" (checked before the API key). Defaults to 50 if unset.
INTERCEPTA_BUDGET=

# Base mainnet RPC used to read pool facts (token0, token1, fee, liquidity,
# slot0.tick, block number). Defaults to https://mainnet.base.org if unset.
BASE_RPC_URL=

# --- apps/seller ---

# EVM address the seller is paid to (Base Sepolia exact-USDC, 0.001 per call).
SELLER_PAY_TO=

# HTTP port the seller listens on. Defaults to 8787 if unset.
PORT=

# --- apps/buyer ---

# Private key of a Base Sepolia testnet dust wallet. Never a funded or
# production key.
BUYER_PRIVATE_KEY=

# Comma-separated list of payTo addresses the buyer is allowed to pay.
BUYER_PAYTO_ALLOWLIST=

# --- scripts/demo.ts (case 2) ---

# A known-risk Base MAINNET address used as the "impostor" seller's payTo in
# `bun run demo` case 2 (get one from Intercepta's Discord). If unset, case 2
# is skipped with a clear message instead of inventing an address.
IMPOSTOR_PAY_TO=

# Per-call timeout in ms (default 10000). A timeout fails closed: HOLD.
INTERCEPTA_TIMEOUT_MS=
